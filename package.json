{
  "name": "gith-world-rp",
  "version": "1.0.0",
  "private": true,
  "description": "Полноэкранная 2D RP-игра с WebSocket-мультиплеером и bullet-hell дуэлями",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.arena.githworld",
    "productName": "Gith World RP",
    "files": ["server.js", "public/**/*", "package.json", "electron/**/*", "node_modules/**/*"],
    "directories": { "buildResources": "public/icons", "output": "release" },
    "win": { "target": "nsis", "icon": "public/icons/app.ico" },
    "linux": { "target": "AppImage", "icon": "public/icons" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
